# codebuddy-prism server environment — copy to deploy/.env (chmod 600, never commit).
# This file reaches the server as ~/codebuddy-prism/.env via ./deploy.sh push.

# AI backend (OpenAI-compatible). Default: Tencent Hunyuan. The key lives ONLY
# in this file on the server; the browser never sees it.
PRISM_AI_API_KEY=
PRISM_AI_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
# Model picker catalog, JSON: [{"id":"hy4-preview","label":"Hunyuan 4 Preview"},…]
# Hunyuan has two OpenAI-compatible entrances: api.hunyuan.cloud.tencent.com/v1
# (pay-per-token) and tokenhub.tencentmaas.com/v1 (Coding Plan subscription).
PRISM_AI_MODELS=

# Public port (8080 by default; open it in the cloud security group)
PRISM_PORT=8080
